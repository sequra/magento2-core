<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <title>SeQura</title>

        <css src="Sequra_Core::css/sequra-core.css"/>
        <link src="Sequra_Core::js/sequra-core/ImagesProvider.js"/>
        <link src="Sequra_Core::js/sequra-core/AjaxService.js"/>
        <link src="Sequra_Core::js/sequra-core/TranslationService.js"/>
        <link src="Sequra_Core::js/sequra-core/TemplateService.js"/>
        <link src="Sequra_Core::js/sequra-core/UtilityService.js"/>
        <link src="Sequra_Core::js/sequra-core/ResponseService.js"/>
        <link src="Sequra_Core::js/sequra-core/PageControllerFactory.js"/>
        <link src="Sequra_Core::js/sequra-core/FormFactory.js"/>
        <link src="Sequra_Core::js/sequra-core/StateUUIDService.js"/>
        <link src="Sequra_Core::js/sequra-core/ElementGenerator.js"/>
        <link src="Sequra_Core::js/sequra-core/ModalComponent.js"/>
        <link src="Sequra_Core::js/sequra-core/DropdownComponent.js"/>
        <link src="Sequra_Core::js/sequra-core/MultiItemSelectorComponent.js"/>
        <link src="Sequra_Core::js/sequra-core/PageHeaderComponent.js"/>
        <link src="Sequra_Core::js/sequra-core/ConnectionSettingsForm.js"/>
        <link src="Sequra_Core::js/sequra-core/DeploymentsSettingsForm.js"/>
        <link src="Sequra_Core::js/sequra-core/DeploymentsModalForm.js"/>
        <link src="Sequra_Core::js/sequra-core/StateController.js"/>
        <link src="Sequra_Core::js/sequra-core/OnboardingController.js"/>
        <link src="Sequra_Core::js/sequra-core/SettingsController.js"/>
    </head>
    <body>
        <referenceContainer name="page.messages">
            <block class="Magento\Framework\View\Element\Messages" name="messages" as="messages"/>
        </referenceContainer>
        <referenceContainer name="content">
            <block class="Sequra\Core\Block\Adminhtml\Configuration\Index" name="adminhtml.sequra.index"
                   template="Sequra_Core::configuration/index.phtml"/>
        </referenceContainer>
    </body>
</page>
