<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="Sequra_Core::css/styles.css"/>
    </head>
    <body>
        <referenceBlock name="head.components">
            <block class="Sequra\Core\Block\WidgetInitializer" name="sequra.widget.initializer"
                   template="Sequra_Core::widget_initializer.phtml" />
        </referenceBlock>
        <referenceContainer name="before.body.end">
            <block class="Magento\Framework\View\Element\Template"
                   name="sequra.express.minicart.init"
                   template="Sequra_Core::express/minicart-init.phtml"/>
        </referenceContainer>
    </body>
</page>
